NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret
# Server-only, stable 32-byte key encoded as 64 hexadecimal characters.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key stable while password operations are pending.
MANAGED_PASSWORD_HMAC_KEY=
APP_URL=http://localhost:3000
# Optional for local database integration tests only
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Server-only screenshot cleanup authorization (Vercel daily backup and Supabase Cron every minute)
CRON_SECRET=

# Server-only; activate only after migration, deployment and readability approval.
SCREENSHOT_COMPRESSION_ENABLED=false
